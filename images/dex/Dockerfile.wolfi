ARG VERSION=v2.45.1
ARG SHIM_VERSION=v2.0.0
ARG TARGETARCH=amd64

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

ARG VERSION
ARG TARGETARCH
RUN apk add --no-cache curl && \
    mkdir -p /usr/local/bin && \
    curl -fsSL "https://github.com/dexidp/dex/releases/download/${VERSION}/dex_${VERSION#v}_linux_${TARGETARCH}.tar.gz" | tar xz --strip-components=1 -C /usr/local/bin

FROM cgr.dev/chainguard/wolfi-base:latest

COPY --from=shim /shim /usr/local/bin/shim
COPY --from=builder /usr/local/bin/dex /usr/local/bin/dex

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"

EXPOSE 5556 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:5556"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "dex"]
CMD ["serve", "/etc/dex/config.docker.yaml"]

LABEL org.opencontainers.image.title="dex" \
      org.opencontainers.image.description="Dex OIDC - wolfi-base, non-root, with health-shim" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/dexidp/dex" \
      evergreen.image.tier="critical" \
      evergreen.constraint.nonroot="true"
LABEL evergreen.base.image="wolfi"
LABEL evergreen.security.cap-drop="ALL"
LABEL evergreen.security.no-new-privileges="true"
LABEL evergreen.security.read-only-rootfs="false"
LABEL evergreen.security.seccomp="runtime-default"
LABEL prometheus.io/scrape="true" prometheus.io/port="9101" prometheus.io/path="/metrics"
STOPSIGNAL SIGTERM
