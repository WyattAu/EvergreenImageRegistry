# EVERGREEN HARDENED POLARIS
# polaris - Evergreen hardened image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
USER 0
COPY --from=shim /shim /usr/local/bin/shim
RUN chown -R 65532:65532 /var/lib/polaris 2>/dev/null || true
USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 8080 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:8080"]

LABEL org.opencontainers.image.title="polaris" \
      org.opencontainers.image.version="10.2.0" \
      org.opencontainers.image.description="polaris - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

