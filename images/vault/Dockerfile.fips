# =============================================================================
# Vault FIPS — FIPS 140-2/3 Compliant
# =============================================================================
# Build Vault with GOEXPERIMENT=boringcrypto for FIPS compliance.
# BoringCrypto requires CGO_ENABLED=1 → glibc → ubi-micro base.
#
# FIPS Compliance:
#   - Go BoringCrypto FIPS 140-2 Certificate #4140
#   - Set GOLANG_FIPS=1 at runtime
#   - Enterprise: VAULT_FIPS=1 for official FIPS mode
# =============================================================================

FROM golang:1.23-bookworm AS builder

ARG VAULT_VERSION=1.17.0

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v${VAULT_VERSION} https://github.com/hashicorp/vault.git /go/src/vault

WORKDIR /go/src/vault

# Build with BoringCrypto FIPS support
RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto GOFLAGS="-modcacherw" \
    go build -trimpath -ldflags="-s -w" -o /vault ./cmd/vault

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /vault /bin/vault

RUN mkdir -p /vault/data /vault/config && \
    chown -R 65532:65532 /vault

ENV GOLANG_FIPS=1
ENV VAULT_ADDR="https://127.0.0.1:8200"

USER 65532:65532

EXPOSE 8200 8201

VOLUME ["/vault/data", "/vault/config"]

ENTRYPOINT ["/bin/vault"]
CMD ["server", "-dev"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/bin/vault", "status", "-address=https://127.0.0.1:8200"] || exit 1

LABEL org.opencontainers.image.title="vault-fips" \
      org.opencontainers.image.description="HashiCorp Vault with FIPS 140-2 BoringCrypto" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="BUSL-1.1" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.fips-cert="4140" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
