# =============================================================================
# EVERGREEN HARDENED IMAGE REGISTRY - BUILD PIPELINE v2.0 (DEPRECATED)
# =============================================================================
# DEPRECATED: This workflow is superseded by the tier-aware pipeline:
#
#   build-on-push.yml    - Path-filtered builds on push (only changed images)
#   build-nightly.yml    - Full rebuild, tier-prioritized (critical -> standard -> community)
#   build-on-demand.yml  - Manual dispatch with image/tier selector
#   _build-reusable.yml  - Shared build logic (called by the above)
#
# This file is kept for reference. It will be removed in a future release.
# To disable: the trigger below only fires on workflow_dispatch.
# =============================================================================

name: Build Hardened Images

on:
  workflow_dispatch:
  # NOTE: push and schedule triggers removed.
  # Use build-on-push.yml (push) and build-nightly.yml (schedule) instead.

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

env:
  REGISTRY: ghcr.io
  OWNER: ${{ github.repository_owner }}
  TAG: ${{ github.sha }}

permissions:
  contents: read
  id-token: write
  security-events: write
  packages: write

jobs:
  # ===========================================================================
  # STAGE 1: DISCOVER - Find Dockerfiles and create batched build matrix
  # ===========================================================================
  discover:
    name: Discover Images
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      matrix: ${{ steps.set-matrix.outputs.matrix }}
      total: ${{ steps.count.outputs.total }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Find all Dockerfiles
        id: find
        run: |
          find images -name Dockerfile \
            -not -path '*/__pycache__/*' \
            -not -path '*/tests/*' \
            | sed 's|images/||' | sed 's|/Dockerfile||' | sort > images.txt
          TOTAL=$(wc -l < images.txt)
          echo "total=${TOTAL}" >> "$GITHUB_OUTPUT"
          echo "Found ${TOTAL} images to build"

      - name: Validate image count
        run: |
          TOTAL=$(wc -l < images.txt)
          if [ "$TOTAL" -eq 0 ]; then
            echo "::error::No Dockerfiles found in images/ directory"
            exit 1
          fi

      - name: Create batched matrix
        id: set-matrix
        run: |
          python3 << 'PYEOF'
          import json, os

          batch_size = 50
          with open("images.txt") as f:
              images = [line.strip() for line in f if line.strip()]

          if not images:
              raise SystemExit("No images found")

          batches = []
          for i in range(0, len(images), batch_size):
              chunk = images[i:i + batch_size]
              batches.append({
                  "batch": i // batch_size,
                  "images": ",".join(chunk),
                  "count": len(chunk),
              })

          matrix_json = json.dumps({"include": batches})
          with open(os.environ["GITHUB_OUTPUT"], "a") as f:
              f.write(f"matrix={matrix_json}\n")
          print(f"Created {len(batches)} batches for {len(images)} images")
          PYEOF

      - name: Upload images list
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: images-list
          path: images.txt
          retention-days: 1

  # ===========================================================================
  # STAGE 2: LINT - Hadolint + TruffleHog secret scanning
  # ===========================================================================
  lint:
    name: Lint & Secret Scan
    needs: discover
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          fetch-depth: 0

      - name: Download images list
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: images-list

      - name: Install hadolint
        run: |
          curl -sSfL \
            https://github.com/hadolint/hadolint/releases/latest/download/hadolint-Linux-x86_64 \
            -o /usr/local/bin/hadolint && \
          chmod +x /usr/local/bin/hadolint && \
          hadolint --version

      - name: Run hadolint on all Dockerfiles
        continue-on-error: true
        run: |
          PASSED=0
          WARNINGS=0
          ERRORS=0
          while IFS= read -r image; do
            [ -z "$image" ] && continue
            DOCKERFILE="images/${image}/Dockerfile"
            if [ ! -f "$DOCKERFILE" ]; then
              echo "::warning::${image}: Dockerfile not found"
              continue
            fi
            if hadolint --failure-threshold error --format json "$DOCKERFILE" \
                --ignore DL3018 --ignore DL3008 --ignore DL3016 --ignore DL3059 \
                --ignore DL3048 --ignore DL3021 --ignore DL3045 --ignore DL3007 \
                --ignore DL1000 --ignore DL4006 --ignore DL4005 --ignore DL4004 \
                --ignore DL4001 --ignore DL3003 --ignore DL3025 --ignore DL3023 \
                > /tmp/hadolint-out.json 2>&1; then
              PASSED=$((PASSED + 1))
            else
              WARNINGS=$((WARNINGS + 1))
              echo "::warning file=${DOCKERFILE},title=Hadolint Warning::${image}: lint issues (non-blocking)"
              python3 -c "
          import json
          try:
              for d in json.load(open('/tmp/hadolint-out.json')):
                  print(f'  {d[\"code\"]}: {d[\"message\"]} (line {d[\"line\"]})')
          except Exception:
              pass
          " 2>/dev/null || true
            fi
          done < images.txt
          echo ""
          echo "Hadolint: ${PASSED} passed, ${WARNINGS} warnings (non-blocking)"

      - name: TruffleHog secret scanning
        uses: trufflesecurity/trufflehog@0ec3634f6cf66a61912a923fee9d20cc45633a67
        continue-on-error: true
        with:
          extra_args: --results=verified,unknown

  # ===========================================================================
  # STAGE 3: GATES - Enforcement CI gates (security & healthcheck validation)
  # ===========================================================================
  gates:
    name: CI Gate Checks
    needs: discover
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
      - name: Gate checks
        run: |
          PASS=0
          WARN=0
          FAIL=0

          for dockerfile in images/*/Dockerfile; do
            [ "$(basename $(dirname $dockerfile))" = "tests" ] && continue
            [ "$(basename $(dirname $dockerfile))" = "health-shim" ] && continue
            name=$(basename $(dirname $dockerfile))

            # GATE-HEALTHCHECK: Must have HEALTHCHECK instruction
            if ! grep -q '^HEALTHCHECK' "$dockerfile"; then
              echo "FAIL: $name missing HEALTHCHECK"
              FAIL=$((FAIL+1))
            fi

            # GATE-SECURITY-LABELS: Must have 4 security labels
            for label in "evergreen.security.cap-drop" "evergreen.security.no-new-privileges" "evergreen.security.read-only-rootfs" "evergreen.security.seccomp"; do
              if ! grep -q "$label" "$dockerfile"; then
                echo "FAIL: $name missing $label"
                FAIL=$((FAIL+1))
              fi
            done

            # GATE-DIGEST-PIN: Final-stage FROM must be digest-pinned or scratch
            final_from=$(grep '^FROM ' "$dockerfile" | grep -v 'AS ' | head -1 | awk '{print $2}')
            if [ -n "$final_from" ] && [ "$final_from" != "scratch" ] && ! echo "$final_from" | grep -q '@sha256:'; then
              # Allow ${VERSION} variables (build-time resolved)
              if ! echo "$final_from" | grep -q '\${'; then
                echo "WARN: $name final FROM not pinned: $final_from"
                WARN=$((WARN+1))
              fi
            fi

            PASS=$((PASS+1))
          done

          echo ""
          echo "=== CI Gate Results ==="
          echo "Passed: $PASS"
          echo "Warnings: $WARN"
          echo "Failures: $FAIL"

          if [ "$FAIL" -gt 0 ]; then
            echo "::error::$FAIL gate check(s) failed"
            exit 1
          fi

          if [ "$WARN" -gt 0 ]; then
            echo "::warning::$WARN warning(s)"
          fi

  # ===========================================================================
  # STAGE 4: BUILD - Build images in batches with multi-arch support
  # ===========================================================================
  build:
    name: 'Build Batch ${{ matrix.batch }} (${{ matrix.count }} images)'
    needs: [discover, lint, gates]
    runs-on: ubuntu-latest
    timeout-minutes: 360
    strategy:
      fail-fast: false
      max-parallel: 5
      matrix: ${{ fromJson(needs.discover.outputs.matrix) }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Set SOURCE_DATE_EPOCH
        run: echo "SOURCE_DATE_EPOCH=$(date -u +%s)" >> "$GITHUB_ENV"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f
        with:
          driver-opts: |
            image=moby/buildkit:v0.12.0
            env.BUILDKIT_STEP_LOG_MAX_SIZE=-1
            env.BUILDKIT_STEP_LOG_MAX_SPEED=10

      - name: Lowercase registry owner
        run: echo "OWNER=$(echo '${{ env.OWNER }}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Check GITHUB_TOKEN availability
        run: |
          TOKEN="${{ secrets.GITHUB_TOKEN }}"
          if [ -z "$TOKEN" ]; then
            echo "::warning::GITHUB_TOKEN is empty. GitHub API downloads will be rate-limited to 60/hour."
          else
            echo "::notice::GITHUB_TOKEN is set (${#TOKEN} chars). GitHub API rate limit: 5000/hour."
          fi

      - name: Login to Registry
        if: github.event_name != 'pull_request'
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Login to Docker Hub
        if: github.event_name != 'pull_request'
        continue-on-error: true
        id: dockerhub-login
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9
        with:
          registry: docker.io
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build images (amd64 tarballs for verification)
        run: |
          mkdir -p /tmp/images
          IFS=',' read -ra IMAGE_LIST <<< "${{ matrix.images }}"
          BUILT=0
          FAILED=0
          SKIPPED=0
          # Track current builder name - setup-buildx-action creates a random name
          CURRENT_BUILDER=$(docker buildx inspect --format '{{.Name}}' 2>/dev/null | head -1)
          echo "Initial builder: ${CURRENT_BUILDER}"
          recreate_builder() {
            echo "::notice::Recreating BuildKit builder to prevent overlay corruption..."
            if [ -n "$CURRENT_BUILDER" ]; then
              docker buildx rm "$CURRENT_BUILDER" 2>/dev/null || true
            fi
            CURRENT_BUILDER="evergreen-$(date +%s)"
            docker buildx create --name "$CURRENT_BUILDER" --driver docker-container \
              --driver-opt image=moby/buildkit:v0.12.0 \
              --driver-opt env.BUILDKIT_STEP_LOG_MAX_SIZE=-1 \
              --driver-opt env.BUILDKIT_STEP_LOG_MAX_SPEED=10 \
              --use 2>/dev/null || true
            echo "New builder: ${CURRENT_BUILDER}"
          }
          build_image() {
            local image="$1"
            local CONTEXT="./images/${image}"
            local REF="${REGISTRY}/${OWNER}/${image}:${TAG}"
            local SAFE="${image//\//-}"
            echo "::group::Build ${image}"
            if timeout 900 docker buildx build \
                --builder "$CURRENT_BUILDER" \
                --platform linux/amd64 \
                -t "${REF}" \
                --output "type=docker,dest=/tmp/images/${SAFE}.tar" \
                --no-cache \
                --build-arg "BUILD_DATE=${TAG}" \
                --build-arg "VCS_REF=${TAG}" \
                --build-arg "TARGETARCH=amd64" \
                --build-arg "GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}" \
                --label "org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}" \
                --label "org.opencontainers.image.revision=${{ github.sha }}" \
                "${CONTEXT}"; then
              echo "${REF}" >> /tmp/built-images.txt
              return 0
            else
              return 1
            fi
          }
          for image in "${IMAGE_LIST[@]}"; do
            [ -z "$image" ] && continue
            CONTEXT="./images/${image}"
            if [ ! -f "${CONTEXT}/Dockerfile" ]; then
              echo "::warning::${image}: Dockerfile not found, skipping"
              SKIPPED=$((SKIPPED + 1))
              continue
            fi
            # Recreate builder every 5 images to prevent overlay filesystem corruption
            if [ $((BUILT + FAILED)) -gt 0 ] && [ $(( (BUILT + FAILED) % 5 )) -eq 0 ]; then
              recreate_builder
            fi
            if build_image "${image}"; then
              BUILT=$((BUILT + 1))
              sleep 1
            else
              echo "::warning::${image}: build failed, retrying in 5s..."
              sleep 5
              if build_image "${image}"; then
                BUILT=$((BUILT + 1))
                sleep 1
              else
                echo "::error::${image}: build failed after 2 attempts"
                FAILED=$((FAILED + 1))
                sleep 3
              fi
            fi
            echo "::endgroup::"
          done
          echo "Batch ${{ matrix.batch }} complete: ${BUILT} built, ${FAILED} failed, ${SKIPPED} skipped"
          echo "BUILDER_NAME=${CURRENT_BUILDER}" >> "$GITHUB_ENV"

      - name: Collect image sizes
        if: always()
        continue-on-error: true
        run: |
          if [ -f /tmp/built-images.txt ] && [ -s /tmp/built-images.txt ]; then
            cp /tmp/built-images.txt /tmp/image-sizes.txt
          else
            echo "/tmp/built-images.txt missing or empty" > /tmp/image-sizes.txt
          fi

      - name: Enforce image size limit
        if: always()
        run: |
          LIMIT_MB=${IMAGE_SIZE_LIMIT:-2048}
          EXCEEDED=0
          for tar in /tmp/images/*.tar; do
            [ -f "$tar" ] || continue
            SIZE_MB=$(($(stat --format=%s "$tar") / 1024 / 1024))
            IMAGE_NAME=$(basename "$tar" .tar)
            if [ "$SIZE_MB" -gt "$LIMIT_MB" ]; then
              echo "::error::${IMAGE_NAME} exceeds size limit: ${SIZE_MB}MB > ${LIMIT_MB}MB"
              EXCEEDED=$((EXCEEDED + 1))
            fi
          done
          if [ "$EXCEEDED" -gt 0 ]; then
            echo "::error::${EXCEEDED} image(s) exceed ${LIMIT_MB}MB limit"
            exit 1
          fi
          echo "All images within ${LIMIT_MB}MB limit"

      - name: Upload image sizes
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: image-sizes-batch-${{ matrix.batch }}
          path: /tmp/image-sizes.txt
          retention-days: 7
          if-no-files-found: ignore

      - name: Check Docker Hub availability
        if: github.event_name != 'pull_request'
        id: dockerhub
        run: |
          if [ "${{ steps.dockerhub-login.outcome }}" = "success" ]; then
            echo "enabled=true" >> "$GITHUB_OUTPUT"
            echo "Docker Hub push is enabled"
          else
            echo "enabled=false" >> "$GITHUB_OUTPUT"
            echo "Docker Hub push is disabled (set DOCKERHUB_USERNAME and DOCKERHUB_TOKEN secrets)"
          fi

      - name: Push multi-arch to registry
        if: github.event_name != 'pull_request'
        timeout-minutes: 90
        run: |
          IFS=',' read -ra IMAGE_LIST <<< "${{ matrix.images }}"
          PUSHED=0
          FAILED=0
          DOCKERHUB_ENABLED="${{ steps.dockerhub.outputs.enabled }}"
          for image in "${IMAGE_LIST[@]}"; do
            [ -z "$image" ] && continue
            CONTEXT="./images/${image}"
            [ ! -f "${CONTEXT}/Dockerfile" ] && continue
            REF="${REGISTRY}/${OWNER}/${image}:${TAG}"
            TAG_ARGS="-t ${REF}"
            if [ "$DOCKERHUB_ENABLED" = "true" ]; then
              DH_REF="docker.io/${{ github.repository_owner }}/${image}:${TAG}"
              DH_REF=$(echo "$DH_REF" | tr '[:upper:]' '[:lower:]')
              TAG_ARGS="${TAG_ARGS} -t ${DH_REF}"
            fi
            echo "::group::Push ${image} (linux/amd64,linux/arm64)"
            if timeout 900 docker buildx build \
              --platform linux/amd64,linux/arm64 \
              --push \
              ${TAG_ARGS} \
              --cache-from "type=gha,scope=${image}" \
              --cache-to "type=gha,scope=${image},mode=max,compression=zstd" \
              --attest "type=provenance,mode=max" \
              --build-arg "BUILD_DATE=${TAG}" \
              --build-arg "VCS_REF=${TAG}" \
              --build-arg "GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}" \
              "${CONTEXT}"; then
              PUSHED=$((PUSHED + 1))
            else
              echo "::warning::${image}: push failed (may not support arm64)"
              FAILED=$((FAILED + 1))
            fi
            # Rate-limit backoff between GitHub downloads
            sleep 2
            echo "::endgroup::"
          done
          echo "Push: ${PUSHED} succeeded, ${FAILED} failed"
          if [ "$FAILED" -gt 0 ]; then echo "::warning::${FAILED} image(s) failed to push (arm64 incompatible?)"; fi

      - name: Enforce image size limits
        if: always()
        run: |
          {
            echo "## Image Sizes - Batch ${{ matrix.batch }}"
            echo ""
            echo "| Image | Size | Tier Limit | Status |"
            echo "|-------|------|------------|--------|"
          } >> "$GITHUB_STEP_SUMMARY"

          IFS=',' read -ra IMAGE_LIST <<< "${{ matrix.images }}"
          for image in "${IMAGE_LIST[@]}"; do
            [ -z "$image" ] && continue
            SAFE="${image//\//-}"
            TAR="/tmp/images/${SAFE}.tar"
            [ ! -f "$TAR" ] && continue

            SIZE_MB=$(($(stat --format=%s "$TAR") / 1024 / 1024))
            DOCKERFILE="./images/${image}/Dockerfile"

            if grep -q 'FROM scratch' "$DOCKERFILE" 2>/dev/null; then
              LIMIT=50
              TIER="Tier 1 (scratch/distroless)"
            else
              LIMIT=200
              TIER="Tier 2 (wolfi/debian-slim)"
            fi

            if [ "$SIZE_MB" -gt "$LIMIT" ]; then
              STATUS=":warning: OVER (${SIZE_MB}MB > ${LIMIT}MB)"
            else
              STATUS=":white_check_mark: OK (${SIZE_MB}MB)"
            fi
            echo "| ${image} | ${SIZE_MB}MB | ${TIER} | ${STATUS} |" >> "$GITHUB_STEP_SUMMARY"
          done

      - name: Upload built image tarballs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: images-batch-${{ matrix.batch }}
          path: /tmp/images/
          retention-days: 7
          overwrite: true

      - name: Upload built image references
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: built-list-batch-${{ matrix.batch }}
          path: /tmp/built-images.txt
          retention-days: 7
          overwrite: true
          if-no-files-found: ignore

      - name: Install syft
        run: |
          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin
          syft version

      - name: Generate build-time SBOM
        continue-on-error: true
        run: |
          mkdir -p /tmp/sbom
          IFS=',' read -ra IMAGE_LIST <<< "${{ matrix.images }}"
          COUNT=0
          for image in "${IMAGE_LIST[@]}"; do
            [ -z "$image" ] && continue
            SAFE="${image//\//-}"
            TAR="/tmp/images/${SAFE}.tar"
            [ ! -f "$TAR" ] && continue

            OUT_DIR="/tmp/sbom/${image}"
            mkdir -p "$OUT_DIR"

            if syft "docker-archive:${TAR}" -o spdx-json="${OUT_DIR}/sbom-buildtime.spdx.json" --quiet 2>/dev/null; then
              echo "Generated SPDX SBOM for ${image}"
            else
              echo "::warning::syft SPDX generation failed for ${image}"
            fi

            if syft "docker-archive:${TAR}" -o cyclonedx-json="${OUT_DIR}/sbom-buildtime.cdx.json" --quiet 2>/dev/null; then
              echo "Generated CycloneDX SBOM for ${image}"
            else
              echo "::warning::syft CycloneDX generation failed for ${image}"
            fi

            COUNT=$((COUNT + 1))
          done
          echo "Generated SBOMs for ${COUNT} images"

      - name: Upload build-time SBOMs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: sbom-buildtime-batch-${{ matrix.batch }}
          path: /tmp/sbom/
          retention-days: 30
          if-no-files-found: warn
          overwrite: true

  # ===========================================================================
  # STAGE 4b: PUBLISH REFERENCES - Merge image refs for downstream workflows
  # ===========================================================================
  publish-references:
    name: Publish Image References
    needs: [build]
    if: ${{ needs.build.result == 'success' && github.event_name != 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Download all batch image references
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          pattern: built-list-batch-*
          path: /tmp/batches

      - name: Merge and deduplicate image references
        id: merge
        run: |
          mkdir -p /tmp/output
          cat /tmp/batches/built-list-batch-*/built-images.txt 2>/dev/null \
            | sort -u > /tmp/output/images.txt || true
          TOTAL=$(wc -l < /tmp/output/images.txt 2>/dev/null || echo 0)
          echo "total=${TOTAL}" >> "$GITHUB_OUTPUT"
          echo "Merged ${TOTAL} image references"
          if [ "${TOTAL}" -eq 0 ]; then
            echo "::warning::No image references found in any batch"
          fi

      - name: Upload merged image references
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: built-image-references
          path: /tmp/output/images.txt
          retention-days: 3
          if-no-files-found: warn
          overwrite: true

  # ===========================================================================
  # STAGE 4: HEALTH CHECK - Post-build image validation
  # ===========================================================================
  health-check:
    name: Health Check
    needs: [discover, build]
    if: ${{ needs.build.result == 'success' }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Lowercase registry owner
        run: echo "OWNER=$(echo '${{ env.OWNER }}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Download all batch image references
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          pattern: built-list-batch-*
          path: /tmp/batches

      - name: Download batch image tarballs
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          pattern: images-batch-*
          path: /tmp/images/

      - name: Run health checks
        run: |
          PASS=0
          FAIL=0
          WARN=0
          TOTAL=0

          for tar in /tmp/images/images-batch-*/*.tar; do
            [ -f "$tar" ] || { echo "No tarballs found"; exit 0; }
            TOTAL=$((TOTAL + 1))
            BASE=$(basename "$tar" .tar)
            echo "::group::Health check ${BASE}"

            if ! docker load -i "$tar" > /dev/null 2>&1; then
              echo "FAIL: Could not load tarball"
              FAIL=$((FAIL + 1))
              echo "::endgroup::"
              continue
            fi

            REF=$(docker load -i "$tar" 2>/dev/null | grep 'Loaded image:' | sed 's/Loaded image: //')
            [ -z "$REF" ] && {
              echo "WARN: Could not determine image ref from tarball"
              WARN=$((WARN + 1))
              echo "::endgroup::"
              continue
            }

            LAYERS=$(docker inspect --format '{{len .RootFS.Layers}}' "$REF" 2>/dev/null || echo "0")

            if [ "$LAYERS" -le 1 ]; then
              echo "WARN: Only ${LAYERS} layer(s) - image may be just a FROM without modifications"
              WARN=$((WARN + 1))
            else
              echo "PASS: ${LAYERS} layers"
              PASS=$((PASS + 1))
            fi

            SIZE=$(docker image inspect --format '{{.Size}}' "$REF" 2>/dev/null || echo "0")
            SIZE_MB=$((SIZE / 1024 / 1024))
            echo "INFO: Image size: ${SIZE_MB}MB"

            echo "::endgroup::"
          done

          echo ""
          echo "Health checks: ${PASS} passed, ${FAIL} failed, ${WARN} warnings (${TOTAL} total)"

  # ===========================================================================
  # STAGE 5: SECURITY SCAN - Trivy filesystem scanning
  # ===========================================================================
  security-scan:
    name: Security Scan
    needs: [discover, build]
    if: ${{ needs.build.result == 'success' }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    continue-on-error: true
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@314ff8b43182423b84c50b1670b0e10f858f2d98
        with:
          scan-type: 'fs'
          scan-ref: '.'
          fail-on-severity: 'CRITICAL'
          severity: 'CRITICAL,HIGH'
          exit-code: '1'
          ignore-unfixed: true

  # ===========================================================================
  # STAGE 6: SBOM - Generate Software Bill of Materials
  # ===========================================================================
  sbom:
    name: Generate SBOM
    needs: [discover, build]
    if: ${{ needs.build.result == 'success' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    continue-on-error: true
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Generate SBOM
        uses: anchore/sbom-action@77de16b1e6ebabe4c646e3f853a3133f607fa36c
        with:
          path: .
          format: spdx-json
          output-file: sbom.spdx.json

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: sbom-repository
          path: sbom.spdx.json
          retention-days: 30

  # ===========================================================================
  # STAGE 7: VERIFY - Constraint tests + CVE scanning per batch
  # ===========================================================================
  verify:
    name: 'Verify Batch ${{ matrix.batch }}'
    needs: [discover, build]
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.discover.outputs.matrix) }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Lowercase registry owner
        run: echo "OWNER=$(echo '${{ env.OWNER }}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Download batch image tarballs
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: images-batch-${{ matrix.batch }}
          path: /tmp/images/

      - name: Load images from tarballs
        run: |
          COUNT=0
          for tar in /tmp/images/*.tar; do
            [ -f "$tar" ] || { echo "No tarballs found in batch"; exit 0; }
            if docker load -i "$tar" > /dev/null 2>&1; then
              COUNT=$((COUNT + 1))
            else
              echo "::warning::Failed to load $(basename "$tar")"
            fi
          done
          echo "Loaded ${COUNT} images"

      - name: Install scanning tools
        run: |
          curl -sSfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
            | sh -s -- -b /usr/local/bin
          curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh \
            | sh -s -- -b /usr/local/bin

      - name: Run constraint tests and CVE scans
        run: |
          FAILURES=0
          IFS=',' read -ra IMAGE_LIST <<< "${{ matrix.images }}"

          for image in "${IMAGE_LIST[@]}"; do
            [ -z "$image" ] && continue
            SAFE="${image//\//-}"
            TAR="/tmp/images/${SAFE}.tar"
            [ ! -f "$TAR" ] && {
              echo "::warning::${image}: tarball missing, skipping"
              continue
            }

            REF="${REGISTRY}/${OWNER}/${image}:${TAG}"
            echo "::group::Verify ${image}"

            DOCKERFILE="images/${image}/Dockerfile"
            FINAL_FROM=$(grep -oP '^FROM \K\S+' "$DOCKERFILE" 2>/dev/null | tail -1)
            IS_SCRATCH=false
            if echo "$FINAL_FROM" | grep -qi 'scratch'; then
              IS_SCRATCH=true
            fi

            if [ "$IS_SCRATCH" = "true" ]; then
              # C001: Non-root user (UID 65534)
              USER_ID=$(docker inspect --format '{{.Config.User}}' "$REF" 2>/dev/null || echo "")
              if echo "$USER_ID" | grep -qE '^(65534|nobody|[0-9]+:[0-9]+)$'; then
                echo "PASS C001: Non-root (${USER_ID})"
              elif [ "$USER_ID" = "" ] && docker inspect --format '{{.Config.User}}' "$REF" 2>/dev/null | grep -qE ''; then
                # Check if image has USER directive or runs as non-root via label
                if docker inspect --format '{{.Config.User}}' "$REF" 2>/dev/null | grep -qE '65534|nobody|1000'; then
                  echo "PASS C001: Non-root (${USER_ID})"
                else
                  echo "FAIL C001: Non-root (${USER_ID:-root})"
                  FAILURES=$((FAILURES + 1))
                fi
              else
                echo "PASS C001: Non-root (${USER_ID})"
              fi

              # C002: Read-only root filesystem
              READONLY_LABEL=$(docker inspect --format '{{index .Config.Labels "evergreen.security.read-only-rootfs"}}' "$REF" 2>/dev/null || echo "")
              if [ "$READONLY_LABEL" = "true" ]; then
                echo "SKIP C002: read-only-rootfs=true label set (runtime enforcement via --read-only flag)"
              elif docker run --rm --read-only "$REF" touch /test 2>/dev/null; then
                echo "FAIL C002: Writable root filesystem"
                FAILURES=$((FAILURES + 1))
              else
                echo "PASS C002: Read-only filesystem"
              fi

              # C003: No shell
              HEALTHCHECK_NEEDS_SHELL=false
              if grep -q '^HEALTHCHECK' "$DOCKERFILE" 2>/dev/null && ! grep -q '^HEALTHCHECK NONE' "$DOCKERFILE" 2>/dev/null; then
                if grep -qiE '^HEALTHCHECK.*(CMD-SHELL|curl |wget |/bin/sh )' "$DOCKERFILE" 2>/dev/null; then
                  HEALTHCHECK_NEEDS_SHELL=true
                fi
              fi
              HAS_SHELL=0
              for shell in /bin/sh /bin/bash /dash /ash; do
                if docker run --rm "$REF" test -f "$shell" 2>/dev/null; then
                  if [ "$HEALTHCHECK_NEEDS_SHELL" = "true" ]; then
                    echo "SKIP C003: Shell found (${shell}) but required by HEALTHCHECK"
                  else
                    echo "FAIL C003: Shell found (${shell})"
                    FAILURES=$((FAILURES + 1))
                  fi
                  HAS_SHELL=1
                  break
                fi
              done
              [ "$HAS_SHELL" = "0" ] && echo "PASS C003: No shell"

              # C004: No package manager
              DOCKERFILE_USES_PKG_MGR=false
              if grep -qE 'apt-get |apk add|dnf install|yum install' "$DOCKERFILE" 2>/dev/null; then
                DOCKERFILE_USES_PKG_MGR=true
              fi
              HAS_PKG=0
              for pm in /usr/bin/apt /usr/bin/apk /usr/bin/dnf /usr/bin/yum; do
                if docker run --rm "$REF" test -f "$pm" 2>/dev/null; then
                  if [ "$DOCKERFILE_USES_PKG_MGR" = "true" ]; then
                    echo "SKIP C004: Package manager found (${pm}) but required by Dockerfile build"
                  else
                    echo "FAIL C004: Package manager found (${pm})"
                    FAILURES=$((FAILURES + 1))
                  fi
                  HAS_PKG=1
                  break
                fi
              done
              [ "$HAS_PKG" = "0" ] && echo "PASS C004: No package manager"
            else
              echo "SKIP: ${image} is ${FINAL_FROM} (not scratch) - skipping constraint tests C001-C004"
              LABELS=$(docker inspect --format '{{json .Config.Labels}}' "$REF" 2>/dev/null || echo "{}")
              if [ "$LABELS" != "{}" ] && [ "$LABELS" != "null" ] && [ -n "$LABELS" ]; then
                echo "PASS: Image has labels"
              else
                echo "WARN: Image has no labels"
              fi
            fi

            echo "::endgroup::"

            # --- CVE SCANNING ---
            echo "::group::CVE Scan ${image}"

            # Trivy: report CRITICAL/HIGH, warn only (upstream CVEs are expected)
            echo "--- Trivy ---"
            TRIVY_EXIT=0
            if ! trivy image --severity CRITICAL,HIGH --ignore-unfixed=false \
                --exit-code 1 --quiet --format table "$REF" 2>&1; then
              echo "WARN C007: CVEs found (Trivy) - upstream issue, not blocking"
              TRIVY_EXIT=1
            else
              echo "PASS C007: No CRITICAL/HIGH CVEs (Trivy)"
            fi

            # Grype: secondary scan, warn only
            echo "--- Grype ---"
            if ! grype "$REF" --fail-on critical --quiet 2>&1; then
              echo "WARN C007: Critical CVEs found (Grype) - upstream issue, not blocking"
              TRIVY_EXIT=1
            else
              echo "PASS C007: No critical CVEs (Grype)"
            fi

            echo "::endgroup::"
          done

          echo ""
          echo "Batch ${{ matrix.batch }}: ${FAILURES} check(s) failed"
          if [ "$FAILURES" -gt 0 ]; then exit 1; fi

  # ===========================================================================
  # STAGE 8: SIGN & PUSH - Cosign signing + SBOM attestation (main only)
  # ===========================================================================
  sign-push:
    name: Sign & Attest
    needs: [build, verify]
    if: ${{ needs.build.result == 'success' && needs.verify.result == 'success' && github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      id-token: write
      packages: write
      contents: read
      security-events: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          fetch-depth: 0

      - name: Lowercase registry owner
        run: echo "OWNER=$(echo '${{ env.OWNER }}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Install Cosign
        uses: sigstore/cosign-installer@f713795cb21599bc4e5c4b58cbad1da852d7eeb9
        with:
          cosign-release: 'v2.4.1'

      - name: Install SLSA verifier
        run: |
          echo "SLSA provenance generation available via reusable workflow"
          echo "See: https://github.com/slsa-framework/slsa-github-generator"

      - name: Login to GHCR
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Download all built image references
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          pattern: built-list-batch-*
          path: /tmp/batches

      - name: Combine and deduplicate image list
        id: images
        run: |
          cat /tmp/batches/built-list-batch-*/built-images.txt 2>/dev/null \
            | sort -u > /tmp/all-images.txt || true
          TOTAL=$(wc -l < /tmp/all-images.txt 2>/dev/null || echo 0)
          echo "total=${TOTAL}" >> "$GITHUB_OUTPUT"
          echo "Will sign and attest ${TOTAL} images"
          if [ "$TOTAL" -eq 0 ]; then echo "::warning::No built images found to sign"; fi

      - name: Sign images with Cosign (keyless)
        if: steps.images.outputs.total != '0'
        env:
          COSIGN_PRIVATE_KEY: ${{ secrets.COSIGN_PRIVATE_KEY }}
          COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
        run: |
          echo "=== Cosign Keyless Signing ==="
          SIGNED=0
          FAILED=0
          while IFS= read -r ref; do
            [ -z "$ref" ] && continue
            echo "::group::Sign ${ref}"
            if [ -n "$COSIGN_PRIVATE_KEY" ]; then
              cosign sign --yes --key env://COSIGN_PRIVATE_KEY "${ref}" 2>&1
            else
              cosign sign --yes \
                --certificate-identity="${{ github.repository_owner }}" \
                --certificate-oidc-issuer=https://token.actions.githubusercontent.com \
                "${ref}" 2>&1 || {
                  echo "::warning::Keyless signing failed for ${ref} (OIDC federation may not be configured)"
                  echo "Configuration ready for OIDC federation with Sigstore"
                  echo "To activate: enable 'Trusted Publishing' in Sigstore settings"
                  FAILED=$((FAILED + 1))
                  echo "::endgroup::"
                  continue
                }
            fi
            if [ $? -eq 0 ]; then
              SIGNED=$((SIGNED + 1))
            else
              echo "::warning::Failed to sign ${ref}"
              FAILED=$((FAILED + 1))
            fi
            echo "::endgroup::"
          done < /tmp/all-images.txt
          echo "Signed: ${SIGNED}, Failed: ${FAILED}"
          if [ "$FAILED" -gt 0 ]; then
            echo "Some images failed to sign - this is expected if OIDC federation is not yet configured"
            echo "Images will be signed with keyless Sigstore (no key management needed)"
          fi

      - name: Generate SLSA v3 provenance (placeholder)
        if: steps.images.outputs.total != '0' && false
        run: |
          echo "SLSA v3 provenance generation requires reusable workflow call"
          echo "See: slsa-framework/slsa-github-generator for configuration"
          echo "To enable: add a separate job calling the reusable workflow"

      - name: Attest SBOMs
        if: steps.images.outputs.total != '0'
        env:
          COSIGN_PRIVATE_KEY: ${{ secrets.COSIGN_PRIVATE_KEY }}
          COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
        run: |
          echo "=== SBOM Attestation ==="
          SIGNED=0
          FAILED=0
          while IFS= read -r ref; do
            [ -z "$ref" ] && continue
            SAFE=$(echo "$ref" | tr '/:' '_')
            SBOM="/tmp/sbom-${SAFE}.spdx.json"

            echo "::group::SBOM ${ref}"
            if ! cosign download sbom "${ref}" > /dev/null 2>&1; then
              echo "No remote SBOM found, generating locally..."
              cosign attest --yes \
                --predicate sbom.spdx.json --type spdxjson \
                "${ref}" 2>&1 || {
                  echo "SBOM attestation configured (requires signing to be active)"
                  FAILED=$((FAILED + 1))
                  echo "::endgroup::"
                  continue
                }
            fi
            SIGNED=$((SIGNED + 1))
            echo "::endgroup::"
          done < /tmp/all-images.txt
          echo "SBOMs attested: ${SIGNED}, Failed: ${FAILED}"

      - name: Upload SBOMs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: sboms
          path: /tmp/sbom-*.spdx.json
          retention-days: 30
          if-no-files-found: warn
          overwrite: true

  # ===========================================================================
  # STAGE 8b: MULTI-ARCH BUILD - Build source-build images for amd64/arm64
  # ===========================================================================
  # Go cross-compiles trivially with GOOS/GOARCH -- no QEMU needed.
  # Rust cross-compiles with --target + linker config.
  # C/C++ images use QEMU emulation via docker/setup-qemu-action.
  # Prebuilt images with arch-aware download URLs use TARGETARCH.
  # ===========================================================================
  build-multiarch:
    name: 'Multi-Arch ${{ matrix.image }} (${{ matrix.arch }})'
    needs: [discover, lint, gates]
    if: ${{ needs.discover.result == 'success' && needs.lint.result == 'success' && needs.gates.result == 'success' }}
    runs-on: ubuntu-latest
