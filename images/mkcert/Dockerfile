# EVERGREEN HARDENED MKCERT
# mkcert - Evergreen hardened image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
USER 0
COPY --from=shim /shim /usr/local/bin/shim
USER 65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9101"]

LABEL org.opencontainers.image.title="mkcert" \
      org.opencontainers.image.version="1.4.4" \
      org.opencontainers.image.description="mkcert - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

