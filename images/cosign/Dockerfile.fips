# =============================================================================
# Cosign FIPS — FIPS 140-2/3 Compliant
# =============================================================================
# Build Cosign with GOEXPERIMENT=boringcrypto for FIPS compliance.
# BoringCrypto requires CGO_ENABLED=1 → glibc → ubi-micro base.
# =============================================================================

FROM golang:1.23-bookworm AS builder

ARG COSIGN_VERSION=v2.4.0

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${COSIGN_VERSION} https://github.com/sigstore/cosign.git /go/src/cosign

WORKDIR /go/src/cosign

# Build with BoringCrypto FIPS support
RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /cosign ./cmd/cosign

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /cosign /bin/cosign

USER 65532:65532

ENTRYPOINT ["/bin/cosign"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/bin/cosign", "version"] || exit 1

LABEL org.opencontainers.image.title="cosign-fips" \
      org.opencontainers.image.description="Sigstore Cosign with FIPS 140-2 BoringCrypto" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="Apache-2.0" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.fips-cert="4140" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
