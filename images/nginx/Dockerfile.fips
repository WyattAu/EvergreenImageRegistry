# =============================================================================
# Nginx FIPS — FIPS 140-2/3 Compliant
# =============================================================================
# Build Nginx from source linked against OpenSSL 3.x FIPS provider.
# NGINX Plus (commercial) has official FIPS builds.
# Community Nginx requires source rebuild with FIPS OpenSSL.
# =============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk add --no-cache \
    build-base \
    linux-headers \
    openssl-dev \
    openssl-provider-fips \
    pcre-dev \
    zlib-dev \
    wget

ARG NGINX_VERSION=1.27.0

RUN cd /tmp && \
    wget -q https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz && \
    tar xzf nginx-${NGINX_VERSION}.tar.gz && \
    cd nginx-${NGINX_VERSION} && \
    ./configure \
        --prefix=/etc/nginx \
        --sbin-path=/usr/sbin/nginx \
        --modules-path=/usr/lib64/nginx/modules \
        --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/var/log/nginx/error.log \
        --http-log-path=/var/log/nginx/access.log \
        --pid-path=/var/run/nginx.pid \
        --lock-path=/var/run/nginx.lock \
        --with-http_ssl_module \
        --with-http_v2_module \
        --with-http_realip_module \
        --with-http_gzip_static_module \
        --with-stream \
        --with-stream_ssl_module \
        --with-openssl=/usr \
        --with-cc-opt="-fPIE -pie" \
        --with-ld-opt="-Wl,-z,relro -Wl,-z,now" && \
    make -j$(nproc) && \
    make install

FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

RUN apk add --no-cache \
    openssl \
    openssl-provider-fips \
    ca-certificates \
    pcre \
    zlib

# FIPS mode
ENV OPENSSL_CONF=/etc/ssl/openssl.cnf

COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
COPY --from=builder /etc/nginx /etc/nginx

RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run && \
    chown -R 65532:65532 /var/cache/nginx /var/log/nginx /var/run

USER 65532:65532

EXPOSE 80 443

STOPSIGNAL SIGQUIT

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["nginx", "-t"] || exit 1

LABEL org.opencontainers.image.title="nginx-fips" \
      org.opencontainers.image.description="Nginx with FIPS 140-2 OpenSSL provider" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="BSD-2-Clause" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.crypto-backend="openssl-fips"
