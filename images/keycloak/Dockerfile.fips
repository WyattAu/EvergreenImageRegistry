# =============================================================================
# Keycloak FIPS — FIPS 140-2/3 Compliant
# =============================================================================
# Keycloak (Quarkus/Java) with FIPS mode enabled.
# Keycloak 26+ supports native FIPS mode via Quarkus.
# Uses OpenSSL FIPS provider + Java security properties.
#
# FIPS Compliance:
#   - OpenSSL 3.x FIPS provider (JNI bridge)
#   - Java security properties for FIPS mode
#   - quarkus.ssl.native-fips=true
# =============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk add --no-cache \
    java-21-openjdk \
    java-21-openjdk-headless \
    openssl \
    openssl-provider-fips \
    curl

ARG KEYCLOAK_VERSION=26.0.0

RUN mkdir -p /opt/keycloak && \
    cd /opt/keycloak && \
    curl -sL https://github.com/keycloak/keycloak/releases/download/${KEYCLOAK_VERSION}/keycloak-${KEYCLOAK_VERSION}.tar.gz | tar xz --strip-components=1

FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

RUN apk add --no-cache \
    java-21-openjdk-headless \
    openssl \
    openssl-provider-fips \
    bash

# FIPS mode configuration for Java
RUN cat > /etc/java/fips.security.properties << 'EOF'
# FIPS 140-2/3 Security Properties
security.provider.1=org.bouncycastle.jce.provider.BouncyCastleProvider
security.provider.2=org.bouncycastle.jsse.provider.BouncyCastleJsseProvider
EOF

# FIPS OpenSSL configuration
RUN echo "openssl_conf = openssl_init" > /etc/ssl/openssl.cnf && \
    echo "[openssl_init]" >> /etc/ssl/openssl.cnf && \
    echo "providers = provider_sect" >> /etc/ssl/openssl.cnf && \
    echo "[provider_sect]" >> /etc/ssl/openssl.cnf && \
    echo "fips = fips_sect" >> /etc/ssl/openssl.cnf && \
    echo "base = base_sect" >> /etc/ssl/openssl.cnf && \
    echo "[fips_sect]" >> /etc/ssl/openssl.cnf && \
    echo "activate = 1" >> /etc/ssl/openssl.cnf && \
    echo "[base_sect]" >> /etc/ssl/openssl.cnf && \
    echo "activate = 1" >> /etc/ssl/openssl.cnf

ENV OPENSSL_CONF=/etc/ssl/openssl.cnf
ENV JAVA_OPTS="-Djava.security.properties=/etc/java/fips.security.properties -Dquarkus.ssl.native-fips=true"
ENV KC_HOME=/opt/keycloak
ENV KC_HTTP_PORT=8080
ENV KC_HTTPS_PORT=8443
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

COPY --from=builder /opt/keycloak /opt/keycloak

RUN mkdir -p /opt/keycloak/data && \
    chown -R 65532:65532 /opt/keycloak

USER 65532:65532

EXPOSE 8080 8443

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=10 \
  CMD ["/opt/keycloak/bin/kc.sh", "health"] || exit 1

LABEL org.opencontainers.image.title="keycloak-fips" \
      org.opencontainers.image.description="Keycloak with FIPS 140-2 Quarkus mode" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="Apache-2.0" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.crypto-backend="openssl-fips+java"
