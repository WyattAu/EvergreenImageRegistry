# EVERGREEN HARDENED ZOOKEEPER
# Apache ZooKeeper - hardened container image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM zookeeper
USER 0
COPY --from=shim /shim /usr/local/bin/shim
RUN chown -R 65532:65532 /var/lib/zookeeper 2>/dev/null || true
USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 2181 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:2181"]

LABEL org.opencontainers.image.title="zookeeper" \
      org.opencontainers.image.version="latest" \
      org.opencontainers.image.description="Apache ZooKeeper - hardened container image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="upstream" \
      evergreen.entrypoint.pattern="repack-upstream-init" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

