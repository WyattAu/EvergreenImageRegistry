# =============================================================================
# Loki FIPS — FIPS 140-2/3 Compliant
# =============================================================================
FROM golang:1.23-bookworm AS builder

ARG LOKI_VERSION=3.1.0

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v${LOKI_VERSION} https://github.com/grafana/loki.git /go/src/loki

WORKDIR /go/src/loki

RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /loki ./cmd/loki

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /loki /usr/local/bin/loki

RUN mkdir -p /loki/wal /loki/chunks && chown 65532:65532 /loki

ENV GOLANG_FIPS=1

USER 65532:65532

EXPOSE 3100

ENTRYPOINT ["/usr/local/bin/loki"]
CMD ["-config.file=/etc/loki/loki.yaml"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/loki", "-version"] || exit 1

LABEL org.opencontainers.image.title="loki-fips" \
      org.opencontainers.image.description="Loki with FIPS 140-2 BoringCrypto" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
