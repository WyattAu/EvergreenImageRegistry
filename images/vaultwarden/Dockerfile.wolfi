ARG VERSION=1.36.0
ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM vaultwarden/server:${VERSION} AS upstream

FROM cgr.dev/chainguard/wolfi-base:latest

COPY --from=shim /shim /usr/local/bin/shim
COPY --from=upstream /vaultwarden /usr/local/bin/vaultwarden

RUN mkdir -p /data && chown -R 65532:65532 /data

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true" \
    DATA_FOLDER="/data"

EXPOSE 80 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:80"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "vaultwarden"]

LABEL org.opencontainers.image.title="vaultwarden" \
      org.opencontainers.image.description="Vaultwarden (Bitwarden-compatible) - wolfi-base, non-root, with health-shim" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/dani-garcia/vaultwarden" \
      evergreen.image.tier="critical" \
      evergreen.constraint.nonroot="true"
LABEL evergreen.base.image="wolfi"
LABEL evergreen.security.cap-drop="ALL"
LABEL evergreen.security.no-new-privileges="true"
LABEL evergreen.security.read-only-rootfs="false"
LABEL evergreen.security.seccomp="runtime-default"
LABEL prometheus.io/scrape="true" prometheus.io/port="9101" prometheus.io/path="/metrics"
STOPSIGNAL SIGTERM
