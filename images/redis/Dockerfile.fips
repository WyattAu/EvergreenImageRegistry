ARG APP_UID=65532
ARG APP_GID=65532
ARG SHIM_VERSION=v1.3.0
ARG OPENSSL_VERSION=3.0.16
ARG VERSION=7.4.1

FROM cgr.dev/chainguard/wolfi-base AS openssl-builder
ARG OPENSSL_VERSION

RUN apk add --no-cache gcc make glibc-dev glibc-static linux-headers ca-certificates perl-core wget

WORKDIR /src
RUN wget -q "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" -O openssl.tar.gz && \
    tar -xzf openssl.tar.gz

WORKDIR /src/openssl-${OPENSSL_VERSION}
RUN ./config \
        --prefix=/usr/local/ssl-fips \
        --openssldir=/etc/ssl/fips \
        enable-fips && \
    make -j$(nproc) && \
    make install_sw && \
    make install_fips && \
    make install

FROM cgr.dev/chainguard/wolfi-base AS builder
ARG VERSION
ARG OPENSSL_VERSION

RUN apk add --no-cache gcc make glibc-dev glibc-static linux-headers ca-certificates wget

COPY --from=openssl-builder /usr/local/ssl-fips /usr/local/ssl-fips
COPY --from=openssl-builder /etc/ssl/fips /etc/ssl/fips

WORKDIR /src
RUN wget -q "https://download.redis.io/releases/redis-${VERSION}.tar.gz" -O redis.tar.gz && \
    tar -xzf redis.tar.gz && rm redis.tar.gz

RUN cd redis-${VERSION} && \
    make -j$(nproc) \
        BUILD_TLS=yes \
        USE_OPENSSL=yes \
        OPENSSL_PREFIX=/usr/local/ssl-fips \
        FINAL_LIBS="-L/usr/local/ssl-fips/lib64 -lssl -lcrypto" \
        install && \
    mkdir -p /app /var/log/redis /var/cache/redis

FROM ghcr.io/wyattau/evergreenshim/cache-shim:${SHIM_VERSION} AS shim

FROM cgr.dev/chainguard/wolfi-base
COPY --from=shim /shim /usr/local/bin/shim
COPY --from=builder /usr/local/bin/redis-server /usr/local/bin/redis-server
COPY --from=builder /usr/local/bin/redis-cli /usr/local/bin/redis-cli
COPY --from=builder /usr/local/ssl-fips /usr/local/ssl-fips
COPY --from=builder /etc/ssl/fips /etc/ssl/fips
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app /app
COPY --from=builder /var/log/redis /var/log/redis
COPY --from=builder /var/cache/redis /var/cache/redis
COPY shim.toml /etc/evergreen/shim.toml

RUN ln -sf /usr/local/ssl-fips/lib64/libssl.so.3 /usr/lib/libssl.so.3 && \
    ln -sf /usr/local/ssl-fips/lib64/libcrypto.so.3 /usr/lib/libcrypto.so.3 && \
    echo "config_diagnostics = 1" >> /etc/ssl/fipsmodule.cnf && \
    printf 'openssl_conf = openssl_init\n.include /etc/ssl/fipsmodule.cnf\n[openssl_init]\nproviders = provider_sect\n[provider_sect]\nfips = fips_sect\nbase = base_sect\n[base_sect]\nactivate = 1\n' > /etc/ssl/fips.cnf

USER ${APP_UID}:${APP_GID}
ENV OPENSSL_CONF=/etc/ssl/fipsmodule.cnf \
    SHIM_CACHE_ENABLED="true" \
    SHIM_CACHE_MAX_ENTRIES="10000" \
    SHIM_CACHE_DEFAULT_TTL="300" \
    SHIM_CACHE_EVICTION="lru" \
    SHIM_METRICS_ENABLED="true" \
    SHIM_MANAGEMENT_ENABLED="true" \
    SHIM_MANAGEMENT_HOST="0.0.0.0" \
    SHIM_MANAGEMENT_PORT="9102"
WORKDIR /app
EXPOSE 6379 9101 9102

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:6379"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "redis-server"]
CMD ["--", "--bind", "0.0.0.0", "--protected-mode", "no", "--tls-port", "0"]
LABEL org.opencontainers.image.title="redis" \
      org.opencontainers.image.description="Redis - in-memory data structure store and cache (FIPS variant)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="Redis" \
      org.opencontainers.image.source="https://github.com/redis/redis" \
      evergreen.image.tier="critical" \
      evergreen.constraint.nonroot="true" \
      evergreen.fips="true" \
      evergreen.fips.module="openssl-3.0" \
      evergreen.fips.certificate="openssl-fips-3.0"
LABEL evergreen.base.image="wolfi" \
      evergreen.build.type="source-fips" \
      evergreen.metrics.native="ztunnel" \
      evergreen.health.type="exec" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.security.read-only-rootfs="true" \
      evergreen.security.seccomp="runtime-default"
LABEL prometheus.io/scrape="true" \
      prometheus.io/port="9101" \
      prometheus.io/path="/metrics"
STOPSIGNAL SIGTERM
