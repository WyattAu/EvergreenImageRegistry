# =============================================================================
# CoreDNS FIPS — FIPS 140-2/3 Compliant
# =============================================================================
FROM golang:1.23-bookworm AS builder

ARG COREDNS_VERSION=1.11.3

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v${COREDNS_VERSION} https://github.com/coredns/coredns.git /go/src/coredns

WORKDIR /go/src/coredns

RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /coredns

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /coredns /bin/coredns

RUN mkdir -p /etc/coredns && chown 65532:65532 /etc/coredns

ENV GOLANG_FIPS=1

USER 65532:65532

EXPOSE 53 53/udp 9153

ENTRYPOINT ["/bin/coredns"]
CMD ["-conf", "/etc/coredns/Corefile"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/bin/coredns", "-plugins"] || exit 1

LABEL org.opencontainers.image.title="coredns-fips" \
      org.opencontainers.image.description="CoreDNS with FIPS 140-2 BoringCrypto" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
