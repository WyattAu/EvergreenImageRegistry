# EVERGREEN HARDENED BIND-EXPORTER
# BIND exporter for Prometheus
# Source Type: binary-download
# Tier: standard
# Auto-generated by evergreenctl generate

ARG VERSION=0.8.0
ARG SHIM_VERSION=v2.0.0
ARG TARGETARCH

FROM debian:bookworm-slim AS downloader
ARG VERSION
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN ARCH=$(case "${TARGETARCH}" in amd64) echo "amd64" ;; arm64) echo "arm64" ;; *) echo "amd64" ;; esac) && \
    curl -fsSL --retry 3 "https://github.com/prometheus-community/bind_exporter/releases/download/v${VERSION}/bind_exporter-${VERSION}.linux-${ARCH}.tar.gz" -o /tmp/bind_exporter.tar.gz && \
    tar -xzf /tmp/bind_exporter.tar.gz -C /tmp && \
    mv /tmp/bind_exporter /tmp/download

RUN cp /etc/ssl/certs/ca-certificates.crt /ca-certificates.crt

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
COPY --from=shim /shim /usr/local/bin/shim
COPY --from=downloader /tmp/download /usr/local/bin/bind-exporter
COPY --from=downloader /ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 9119 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9119"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "/usr/local/bin/bind-exporter"]

LABEL org.opencontainers.image.title="bind-exporter" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.description="BIND exporter for Prometheus" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="upstream"

STOPSIGNAL SIGTERM

