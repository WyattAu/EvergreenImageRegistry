# EVERGREEN HARDENED HTTPD
# httpd - Evergreen hardened image
# Source Type: binary-download
# Tier: standard
# Auto-generated by evergreenctl generate

ARG VERSION=latest
ARG SHIM_VERSION=v2.0.0
ARG TARGETARCH

FROM debian:bookworm-slim AS downloader
ARG VERSION
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \    curl ca-certificates && \    rm -rf /var/lib/apt/lists/*

RUN arch=$(case ${TARGETARCH} in \    amd64) echo "amd64";; \    arm64) echo "arm64";; \    s390x) echo "s390x";; \    ppc64le) echo "ppc64le";; \    *) echo "amd64";; \    esac) && \    curl -fsSL "https://github.com/httpd" -o /tmp/download && \    chmod +x /tmp/download || \    (curl -fsSL "https://github.com/httpd" -o /tmp/download.tar.gz && \     tar -xzf /tmp/download.tar.gz -C /tmp && \     chmod +x /tmp/httpd) || \    (apt-get update && apt-get install -y unzip && \     curl -fsSL "https://github.com/httpd" -o /tmp/download.zip && \     unzip /tmp/download.zip -d /tmp && \     chmod +x /tmp/httpd)

RUN cp /etc/ssl/certs/ca-certificates.crt /ca-certificates.crt

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
COPY --from=shim /shim /usr/local/bin/shim
COPY --from=downloader /tmp/download /usr/local/bin/httpd
COPY --from=downloader /ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 8080 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:8080"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "/usr/local/bin/httpd"]

LABEL org.opencontainers.image.title="httpd" \
      org.opencontainers.image.version="latest" \
      org.opencontainers.image.description="httpd - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch"

STOPSIGNAL SIGTERM

