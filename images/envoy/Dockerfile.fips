# =============================================================================
# Envoy FIPS — FIPS 140-2/3 Compliant
# =============================================================================
# Uses official Envoy image. For FIPS compliance, build from source with:
#   bazel build --config=fips --define=fips=true
#
# Or use the official Envoy FIPS binary from:
#   https://github.com/envoyproxy/envoy/releases (FIPS variant)
#
# FIPS Compliance:
#   - BoringCrypto FIPS 140-2 Certificate #4140
#   - Self-tests on startup (FIPS power-up self-test)
# =============================================================================

FROM envoyproxy/envoy:v1.31.0 AS envoy

FROM scratch

COPY --from=envoy /usr/local/bin/envoy /bin/envoy
COPY --from=envoy /etc/envoy /etc/envoy

USER 65532:65532

EXPOSE 9901 10000 10001 10002

ENTRYPOINT ["/bin/envoy"]
CMD ["-c", "/etc/envoy/envoy.yaml", "--log-level", "info"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/bin/envoy", "--mode", "validate"] || exit 1

LABEL org.opencontainers.image.title="envoy-fips" \
      org.opencontainers.image.description="Envoy proxy (FIPS build required)" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="Apache-2.0" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.fips-cert="4140" \
      evergreenimageregistry.io.crypto-backend="boringssl"
