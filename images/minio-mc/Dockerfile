# EVERGREEN HARDENED MINIO-MC
# minio-mc - Evergreen hardened image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
USER 0
COPY --from=shim /shim /usr/local/bin/shim
USER 65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9101"]

LABEL org.opencontainers.image.title="minio-mc" \
      org.opencontainers.image.version="RELEASE.2025-08-13T08-35-41Z" \
      org.opencontainers.image.description="minio-mc - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

LABEL evergreen.security.read-only-rootfs="false"
LABEL evergreen.security.seccomp="runtime-default"
