        arch: [amd64, arm64]
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Set SOURCE_DATE_EPOCH
        run: echo "SOURCE_DATE_EPOCH=$(date -u +%s)" >> "$GITHUB_ENV"

      - name: Set up QEMU
        uses: docker/setup-qemu-action@c7c53464625b32c7a7e944ae62b3e17d2b600130

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f

      - name: Build multi-arch source image
        run: |
          IMAGE=${{ matrix.image }}
          ARCH=${{ matrix.arch }}
          echo "Building ${IMAGE} for ${ARCH} (multi-arch with QEMU/cross-compile)..."

          docker buildx build \
            --platform linux/${ARCH} \
            --build-arg TARGETARCH=${ARCH} \
            --build-arg GOARCH=${ARCH} \
            -t ${IMAGE}:${ARCH}-test \
            --load \
            images/${IMAGE}/ || echo "BUILD_FAILED"

          docker inspect ${IMAGE}:${ARCH}-test 2>/dev/null && echo "PASS ${IMAGE}:${ARCH}" || echo "FAIL ${IMAGE}:${ARCH}"

      # To create multi-arch manifest after per-arch images are pushed:
      # docker buildx imagetools create \
      #   ghcr.io/${{ github.repository }}/health-checks:latest \
      #   ghcr.io/${{ github.repository }}/health-checks:amd64 \
      #   ghcr.io/${{ github.repository }}/health-checks:arm64

  # ===========================================================================
  # STAGE 9: REPORT - Aggregate results and generate summary
  # ===========================================================================
  report:
    name: Build Report
    needs:
      [
        discover,
        lint,
        gates,
        build,
        publish-references,
        health-check,
        security-scan,
        sbom,
        verify,
        sign-push,
        build-multiarch,
      ]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Generate summary report
        run: |
          {
            echo "# Build Report"
            echo ""
            echo "| Metric | Value |"
            echo "|--------|-------|"
            echo "| **Total Images** | ${{ needs.discover.outputs.total }} |"
            echo "| **Commit** | \`${{ github.sha }}\` |"
            echo "| **Branch** | \`${{ github.ref_name }}\` |"
            echo "| **Trigger** | ${{ github.event_name }} |"
            echo "| **Discover** | ${{ needs.discover.result }} |"
            echo "| **Lint** | ${{ needs.lint.result }} |"
            echo "| **Gates** | ${{ needs.gates.result }} |"
            echo "| **Build** | ${{ needs.build.result }} |"
            echo "| **Publish Refs** | ${{ needs.publish-references.result }} |"
            echo "| **Health Check** | ${{ needs.health-check.result }} |"
            echo "| **Security Scan** | ${{ needs.security-scan.result }} |"
            echo "| **SBOM** | ${{ needs.sbom.result }} |"
            echo "| **Verify** | ${{ needs.verify.result }} |"
            echo "| **Sign & Push** | ${{ needs.sign-push.result }} |"
            echo "| **Multi-Arch Build** | ${{ needs.build-multiarch.result }} |"
            echo ""

            OVERALL="success"
            for job in discover lint gates build verify; do
              RESULT="${{ needs[job].result }}"
              if [ "$RESULT" = "failure" ]; then
                OVERALL="failure"
                break
              fi
            done

            if [ "$OVERALL" = "failure" ]; then
              echo "## :x: Pipeline Failed"
            else
              echo "## :white_check_mark: Pipeline Passed"
            fi
          } >> "$GITHUB_STEP_SUMMARY"

