# =============================================================================
# Rekor FIPS — FIPS 140-2/3 Compliant
# =============================================================================
FROM golang:1.23-bookworm AS builder

ARG REKOR_VERSION=v1.3.0

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${REKOR_VERSION} https://github.com/sigstore/rekor.git /go/src/rekor

WORKDIR /go/src/rekor

RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /rekor-server ./cmd/rekor-server && \
    CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /rekor-cli ./cmd/rekor-cli

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /rekor-server /bin/rekor-server
COPY --from=builder /rekor-cli /bin/rekor-cli

USER 65532:65532

EXPOSE 3000 8080

ENTRYPOINT ["/bin/rekor-server"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/bin/rekor-cli", "health", "--rekor_server", "http://localhost:3000"] || exit 1

LABEL org.opencontainers.image.title="rekor-fips" \
      org.opencontainers.image.description="Sigstore Rekor with FIPS 140-2 BoringCrypto" \
      org.opencontainers.image.vendor="Evergreen Image Registry" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenImageRegistry" \
      org.opencontainers.image.licenses="Apache-2.0" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.fips-cert="4140" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
