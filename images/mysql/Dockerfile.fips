ARG APP_UID=65532
ARG SHIM_VERSION=latest
ARG APP_GID=65532
ARG SHIM_VERSION=v2.0.0
ARG OPENSSL_VERSION=3.0.16
ARG VERSION=8.4.1

FROM cgr.dev/chainguard/wolfi-base AS openssl-builder
ARG OPENSSL_VERSION

RUN apk add --no-cache gcc make glibc-dev glibc-static linux-headers ca-certificates perl-core wget

WORKDIR /src
RUN wget -q "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" -O openssl.tar.gz && \
    tar -xzf openssl.tar.gz

WORKDIR /src/openssl-${OPENSSL_VERSION}
RUN ./config \
        --prefix=/usr/local/ssl-fips \
        --openssldir=/etc/ssl/fips \
        enable-fips && \
    make -j$(nproc) && \
    make install_sw && \
    make install_fips && \
    make install

FROM cgr.dev/chainguard/wolfi-base AS builder
ARG VERSION

RUN apk add --no-cache gcc g++ make cmake glibc-dev glibc-static linux-headers ca-certificates \
    readline-dev zlib-dev bison flex perl-core wget ncurses-dev rpcsvc-proto

COPY --from=openssl-builder /usr/local/ssl-fips /usr/local/ssl-fips
COPY --from=openssl-builder /etc/ssl/fips /etc/ssl/fips

WORKDIR /src
RUN wget -q "https://dev.mysql.com/get/Downloads/MySQL-8.4/mysql-${VERSION}.tar.gz" -O mysql.tar.gz && \
    tar -xzf mysql.tar.gz

WORKDIR /src/mysql-${VERSION}
RUN mkdir build && cd build && \
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr/local/mysql \
        -DCMAKE_BUILD_TYPE=Release \
        -DWITH_SSL=/usr/local/ssl-fips \
        -DWITH_UNIT_TESTS=OFF \
        -DWITH_EDITLINE=bundled \
        -DWITH_ICU=bundled \
        -DWITH_LZ4=bundled \
        -DWITH_ZLIB=bundled \
        -DWITH_ZSTD=bundled \
        -DFORCE_INSOURCE_BUILD=OFF && \
    make -j$(nproc) && \
    make install

FROM ghcr.io/wyattau/evergreenshim/db-shim:v2.0.0 AS shim

FROM cgr.dev/chainguard/wolfi-base
COPY --from=shim /shim /usr/local/bin/shim
RUN chmod +x /usr/local/bin/shim

COPY --from=builder /usr/local/mysql /usr/local/mysql
COPY --from=openssl-builder /usr/local/ssl-fips /usr/local/ssl-fips
COPY --from=openssl-builder /etc/ssl/fips /etc/ssl/fips
COPY --from=openssl-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN ln -sf /usr/local/ssl-fips/lib64/libssl.so.3 /usr/lib/libssl.so.3 && \
    ln -sf /usr/local/ssl-fips/lib64/libcrypto.so.3 /usr/lib/libcrypto.so.3 && \
    echo "config_diagnostics = 1" >> /etc/ssl/fipsmodule.cnf && \
    printf 'openssl_conf = openssl_init\n.include /etc/ssl/fipsmodule.cnf\n[openssl_init]\nproviders = provider_sect\n[provider_sect]\nfips = fips_sect\nbase = base_sect\n[base_sect]\nactivate = 1\n' > /etc/ssl/fips.cnf && \
    adduser -D -u 65532 -s /bin/false mysql 2>/dev/null || true && \
    mkdir -p /app /var/log/mysql /var/cache/mysql /run/mysqld /var/lib/mysql && \
    chown -R 65532:65532 /app /var/log/mysql /var/cache/mysql /run/mysqld /var/lib/mysql

ENV OPENSSL_CONF=/etc/ssl/fipsmodule.cnf \
    PATH="/usr/local/mysql/bin:${PATH}" \
    HEALTH_CMD="mysqladmin ping -h 127.0.0.1 --silent" \
    READY_CMD="mysqladmin ping -h 127.0.0.1 --silent" \
    STARTUP_CMD="mysqladmin ping -h 127.0.0.1 --silent" \
    EVERGREEN_LOG_LEVEL=info \
    SHIM_BACKUP_ENABLED="true" \
    SHIM_BACKUP_DB_HOST="localhost" \
    SHIM_BACKUP_DB_PORT="3306" \
    SHIM_BACKUP_SCHEDULE="0 2 * * *" \
    SHIM_BACKUP_RETENTION_DAYS="7" \
    SHIM_BACKUP_OUTPUT_DIR="/backups" \
    SHIM_REPLICATION_ENABLED="false" \
    SHIM_MIGRATION_ENABLED="false" \
    SHIM_VAULT_ENABLED="false" \
    SHIM_AUDIT_ENABLED="true" \
    SHIM_METRICS_ENABLED="true" \
    SHIM_ALERTING_ENABLED="false" \
    SHIM_ALERTING_WEBHOOK_URL="" \
    SHIM_SCHEDULER_ENABLED="true" \
    SHIM_SCHEDULER_BACKUP_CRON="0 2 * * *"

USER ${APP_UID}:${APP_GID}
WORKDIR /app
EXPOSE 3306

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:3306"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "mysqld"]
CMD ["-c", "mysqld", "--", "--user=mysql", "--datadir=/var/lib/mysql"]
LABEL org.opencontainers.image.title="mysql" \
      org.opencontainers.image.description="MySQL - open source relational database management system (FIPS variant)" \
      org.opencontainers.image.version="8.4.1" \
      org.opencontainers.image.vendor="Oracle" \
      org.opencontainers.image.platforms="linux/amd64,linux/arm64" \
      evergreen.image.tier="2" \
      evergreen.constraint.nonroot="true" \
      evergreen.constraint.hardened="true" \
      evergreen.fips="true" \
      evergreen.fips.module="openssl-3.0" \
      evergreen.fips.certificate="openssl-fips-3.0" \
      org.opencontainers.image.source="https://github.com/mysql/mysql-server"
LABEL evergreen.base.image="wolfi"
LABEL evergreen.build.type="source-fips"
LABEL evergreen.metrics.native="true"
LABEL evergreen.health.type="http"
LABEL evergreen.security.cap-drop="ALL"
LABEL evergreen.security.no-new-privileges="true"
LABEL evergreen.security.read-only-rootfs="true"
LABEL evergreen.security.seccomp="runtime-default"

EXPOSE 9101
LABEL prometheus.io/scrape="true" \
      prometheus.io/port="9101" \
      prometheus.io/path="/metrics"
STOPSIGNAL SIGTERM
