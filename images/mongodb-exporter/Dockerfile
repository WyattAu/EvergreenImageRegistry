# EVERGREEN HARDENED MONGODB-EXPORTER
# mongodb-exporter - Evergreen hardened image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
USER 0
COPY --from=shim /shim /usr/local/bin/shim
RUN chown -R 65532:65532 /var/lib/mongodb-exporter 2>/dev/null || true
USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 9216 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9216"]

LABEL org.opencontainers.image.title="mongodb-exporter" \
      org.opencontainers.image.version="0.51.0" \
      org.opencontainers.image.description="mongodb-exporter - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

