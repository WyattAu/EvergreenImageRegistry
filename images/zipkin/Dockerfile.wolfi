ARG VERSION=3.4.2
ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

ARG VERSION
RUN apk add --no-cache curl openjdk-21-jre && \
    mkdir -p /zipkin && \
    curl -fsSL "https://repo1.maven.org/maven2/io/zipkin/zipkin-server/${VERSION}/zipkin-server-${VERSION}-exec.jar" -o /zipkin/zipkin.jar

FROM cgr.dev/chainguard/wolfi-base:latest

COPY --from=shim /shim /usr/local/bin/shim
COPY --from=builder /zipkin /zipkin
COPY --from=builder /usr/lib/jvm/java-21-openjdk /usr/lib/jvm/java-21-openjdk

RUN apk add --no-cache java-21-jre-headless

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true" \
    JAVA_HOME="/usr/lib/jvm/java-21-openjdk"

EXPOSE 9411 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9411"]

ENTRYPOINT ["/usr/local/bin/shim", "run", "-c", "java"]
CMD ["-jar", "/zipkin/zipkin.jar"]

LABEL org.opencontainers.image.title="zipkin" \
      org.opencontainers.image.description="Zipkin distributed tracing - wolfi-base, non-root, with health-shim" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/openzipkin/zipkin" \
      evergreen.image.tier="critical" \
      evergreen.constraint.nonroot="true"
LABEL evergreen.base.image="wolfi"
LABEL evergreen.security.cap-drop="ALL"
LABEL evergreen.security.no-new-privileges="true"
LABEL evergreen.security.read-only-rootfs="false"
LABEL evergreen.security.seccomp="runtime-default"
LABEL prometheus.io/scrape="true" prometheus.io/port="9101" prometheus.io/path="/metrics"
STOPSIGNAL SIGTERM
