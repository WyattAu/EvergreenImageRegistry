# =============================================================================
# Consul FIPS — FIPS 140-2/3 Compliant
# =============================================================================
FROM golang:1.23-bookworm AS builder

ARG CONSUL_VERSION=1.19.0

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v${CONSUL_VERSION} https://github.com/hashicorp/consul.git /go/src/consul

WORKDIR /go/src/consul

RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
    go build -trimpath -ldflags="-s -w" -o /bin/consul ./

FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS runtime

COPY --from=builder /bin/consul /usr/local/bin/consul

RUN mkdir -p /consul/data /consul/config && chown 65532:65532 /consul

ENV GOLANG_FIPS=1

USER 65532:65532

VOLUME ["/consul/data"]

EXPOSE 8500 8600/udp 8301 8302

ENTRYPOINT ["/usr/local/bin/consul"]
CMD ["agent", "-dev", "-client=0.0.0.0"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/usr/local/bin/consul", "members"] || exit 1

LABEL org.opencontainers.image.title="consul-fips" \
      org.opencontainers.image.description="Consul with FIPS 140-2 BoringCrypto" \
      evergreenimageregistry.io.fips="true" \
      evergreenimageregistry.io.crypto-backend="golang-boringcrypto"
