# EVERGREEN HARDENED TTYD
# ttyd - Evergreen hardened image
# Source Type: upstream-repack
# Tier: standard
# Auto-generated by evergreenctl generate

ARG SHIM_VERSION=v2.0.0

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM scratch
USER 0
COPY --from=shim /shim /usr/local/bin/shim
RUN chown -R 65532:65532 /var/lib/ttyd 2>/dev/null || true
USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"
EXPOSE 7681 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:7681"]

LABEL org.opencontainers.image.title="ttyd" \
      org.opencontainers.image.version="1.7.7" \
      org.opencontainers.image.description="ttyd - Evergreen hardened image" \
      evergreen.image.tier="standard" \
      evergreen.constraint.nonroot="true" \
      evergreen.security.cap-drop="ALL" \
      evergreen.security.no-new-privileges="true" \
      evergreen.base.image="scratch" \
      evergreen.entrypoint.pattern="repack-upstream-init"

STOPSIGNAL SIGTERM

