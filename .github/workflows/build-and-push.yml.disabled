name: Build and Push Images to GHCR

# This workflow is disabled - using build.yml instead for full builds
# Keeping for reference until fully migrated

on:
  workflow_dispatch:

permissions:
  contents: read
  packages: write
  actions: write

jobs:
  discover:
    runs-on: ubuntu-latest
    outputs:
      images: ${{ steps.discover.outputs.images 
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Discover Dockerfiles
        id: discover
        run: |
          # List directories with Dockerfiles
          cd images
          IMAGES=$(for d in */; do echo "${d%/"; done | tr '\n' ',' | sed 's/,$//')
          cd ..
          echo "images=[$IMAGES]" >> $GITHUB_OUTPUT
          echo "Found: $(echo $IMAGES | tr ',' '\n' | wc -l) images"

  build-and-push:
    needs: discover
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        image: ${{ fromJson(needs.discover.outputs.images) 

    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner 
          password: ${{ secrets.GITHUB_TOKEN 

      - name: Extract Docker metadata
        id: meta
        uses: docker/metadata-action@c299e40c65443455700f0fdfc63efafe5b349051
        with:
          images: ghcr.io/${{ github.repository /${{ matrix.image 
          tags: |
            type=ref,event=branch
            type=ref,event=tag,pattern={{prefixv(.*)
            type=semver,pattern={{prefixv(.*)
            type=raw,value=latest,enable={{ is_default_branch 

      - name: Build and push image
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8
        with:
          context: ./images/${{ matrix.image 
          push: true
          tags: ${{ steps.meta.outputs.tags 
          labels: ${{ steps.meta.outputs.labels 
          cache-from: type=gha
          cache-to: type=gha,mode=max
