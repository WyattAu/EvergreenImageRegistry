ARG VERSION=1.16.2
ARG SHIM_VERSION=v2.0.0
ARG TARGETARCH=amd64

FROM ghcr.io/wyattau/evergreenshim/health-shim:${SHIM_VERSION} AS shim

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

ARG VERSION
ARG TARGETARCH
RUN apk add --no-cache curl && \
    mkdir -p /usr/local/bin && \
    curl -fsSL "https://github.com/favonia/cloudflare-ddns/releases/download/${VERSION}/cloudflare-ddns_${VERSION#v}_linux_${TARGETARCH}.tar.gz" | tar xz -C /usr/local/bin

FROM cgr.dev/chainguard/wolfi-base:latest

COPY --from=shim /shim /usr/local/bin/shim
COPY --from=builder /usr/local/bin/cloudflare-ddns /usr/local/bin/cloudflare-ddns

USER 65532:65532

ENV SHIM_METRICS_ENABLED="true"

EXPOSE 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:9101"]

ENTRYPOINT ["/usr/local/bin/cloudflare-ddns"]

LABEL org.opencontainers.image.title="cloudflare-ddns" \
      org.opencontainers.image.description="Cloudflare DDNS updater - wolfi-base, non-root, with health-shim" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/favonia/cloudflare-ddns" \
      evergreen.image.tier="critical" \
      evergreen.constraint.nonroot="true"
LABEL evergreen.base.image="wolfi"
LABEL evergreen.security.cap-drop="ALL"
LABEL evergreen.security.no-new-privileges="true"
LABEL evergreen.security.read-only-rootfs="true"
LABEL evergreen.security.seccomp="runtime-default"
STOPSIGNAL SIGTERM
